# Local development: copy to .env (git-ignored). On the server use deploy/server.env.example.

SESSION_SECRET=change-me
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=renoviqai

# Where the web app is served from, used for the redirect after Google sign-in
CLIENT_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_FORM_RECEIVER_EMAIL=

# AI redesign (all of these are needed, otherwise POST /api/renovations answers 503)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
S3_BUCKET=
AWS_REGION=us-east-1
# For local development the app needs AWS credentials with access to that bucket. On the EC2 server
# leave these out: the instance role provides them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
