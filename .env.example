# Local development: copy to .env (git-ignored). On the server use deploy/server.env.example.

SESSION_SECRET=change-me
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=renoviqai

# Where the web app is served from, used for the redirect after Google sign-in
CLIENT_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_FORM_RECEIVER_EMAIL=

# AI redesign (all three are needed, otherwise POST /api/renovations answers 503)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
FIREBASE_STORAGE_BUCKET=
# Firebase console > Project settings > Service accounts > Generate new private key, pasted as one line in single quotes
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
