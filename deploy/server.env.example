# Copy to /opt/renoviq/.env on the server and fill it in: nano /opt/renoviq/.env
# Then protect it: chmod 600 /opt/renoviq/.env
# The deploy workflow only checks that this file and these names exist; it never writes it.
# Plain KEY=value lines. Put a value in single quotes if it contains $ or # or spaces.

# MongoDB container, created with these on the first deploy and left alone afterwards.
# Letters and digits only: the password is placed inside a connection URL.
MONGO_USER=renoviq
MONGO_PASSWORD=

SESSION_SECRET=
MONGODB_DB_NAME=renoviqai

# Public address of the site (with https). Used for the redirect after Google sign-in.
CLIENT_ORIGIN=https://renoviq.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://renoviq.example.com/auth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_FORM_RECEIVER_EMAIL=

GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
FIREBASE_STORAGE_BUCKET=
# Service-account JSON from the Firebase console, on ONE line inside single quotes
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
