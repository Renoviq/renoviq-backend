# Copy to /opt/renoviq/.env on the server and chmod 600 it. Never commit the real file.

# --- MongoDB container: letters and digits only, the password is placed inside a URL ---
MONGO_USER=renoviq
MONGO_PASSWORD=

# --- App ---
SESSION_SECRET=
MONGODB_DB_NAME=renoviqai

# Public address of the site (with https). Used for the redirect after Google sign-in.
CLIENT_ORIGIN=https://renoviq.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://renoviq.example.com/auth/google/callback

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_FORM_RECEIVER_EMAIL=

# --- AI redesign ---
GEMINI_API_KEY=
FIREBASE_STORAGE_BUCKET=
# Service account JSON from the Firebase console, as one line inside single quotes
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}'
