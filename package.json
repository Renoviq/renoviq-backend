    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "firebase-admin": "^14.5.0",
    "memorystore": "^1.6.7",
    "mongodb": "^6.16.0",
    "nodemailer": "^7.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
